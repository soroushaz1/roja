<?xml version="1.0" encoding="utf-8"?>
<!-- The whole site ships inside the app, so nothing it shows comes from the internet.
     INTERNET is here for one optional thing only: keeping a skin check on the server to
     compare with later ones, which the panel asks for and does not start until its owner
     turns it on. The picture itself is never sent; see skin-panel.js. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Photo mode works without a camera, so the app installs on any device. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roja">

        <!-- Handling rotation and resizing in place keeps the page, and the camera,
             running instead of reloading. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
